# Postgres connection string (Neon in production, local in dev)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/podtalk
# Shared secret for the web UI login and the Bearer API token
POD_TALK_TOKEN=devtoken
NEXT_PUBLIC_APP_NAME=Pod Talk
# Optional: enables /api/answer via Claude
# ANTHROPIC_API_KEY=
# Optional: enables audio uploads via Vercel Blob
# BLOB_READ_WRITE_TOKEN=
